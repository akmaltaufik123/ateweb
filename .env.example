# Backend-only values. Never prefix secrets with VITE_.
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
BOOSTER_PUBLIC_ORIGIN=http://localhost:3000
BOOSTER_ADMIN_TOKEN=
PADOONSTA_API_KEY=
PADOONSTA_API_URL=https://padooinsta.com/api/v2
# Set an absolute path on a persistent LOCAL volume in production.
BOOSTER_DB_PATH=./data/booster.sqlite
BOOSTER_PROVIDER_CURRENCY=USD
BOOSTER_USD_MYR=4.47
BOOSTER_MARKUP_PERCENT=30
BOOSTER_PROVIDER_TIMEOUT_MS=15000
# Only trusted reverse-proxy source addresses/CIDRs; never blanket true.
BOOSTER_TRUST_PROXY=
# Frontend BUILD setting only; use /booster/ when serving from that path.
VITE_BASE_PATH=/

# Example routing ONLY. Adapt inside the existing, verified TLS virtual host.
# Build with VITE_BASE_PATH=/booster/. Do not replace the existing website root.
location = /booster { return 308 /booster/; }
location /booster/ {
    proxy_pass http://127.0.0.1:3000;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-For $remote_addr;
}
# The application uses canonical domain-root API and admin paths.
# Check for conflicts with existing applications BEFORE enabling these locations.
location /api/ {
    proxy_pass http://127.0.0.1:3000;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_read_timeout 45s;
}
location /admin/booster {
    proxy_pass http://127.0.0.1:3000;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-For $remote_addr;
}
